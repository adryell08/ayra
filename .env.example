# Copie este arquivo para ".env" (mesma pasta) e cole sua chave. O .env NUNCA vai para o Git.
OPENAI_API_KEY=sk-COLOQUE-SUA-CHAVE-AQUI

# --- Realtime (caminho principal). Padrões abaixo; descomente para trocar. ---
# NURIA_MODELO_REALTIME=gpt-realtime-2.1
# NURIA_VOZ_REALTIME=marin          # alloy, ash, ballad, coral, echo, sage, shimmer, verse, marin, cedar
# NURIA_TRANSCRICAO=gpt-4o-mini-transcribe   # só mostra a pergunta na tela; "desligada" desativa
# NURIA_RUIDO=far_field             # near_field (fone de ouvido) | far_field (notebook) | desligado
# NURIA_RACIOCINIO=low              # minimal | low | medium | high; vazio = padrão do modelo
# NURIA_TIMEOUT=30

# --- Gemini Live (alternativa; troque também em Ajustes → API → Provedor) ---
# GEMINI_API_KEY=AIza-COLOQUE-SUA-CHAVE-AQUI   # Google AI Studio
# NURIA_PROVEDOR=openai             # openai (Realtime) | gemini (Gemini Live)
# NURIA_MODELO_GEMINI=gemini-3.8-live
# NURIA_VOZ_GEMINI=Kore             # Kore, Aoede, Leda, Zephyr, Puck, Charon, Fenrir, Orus

# --- Economia de tokens (os dois provedores) ---
# NURIA_MAX_TOKENS=350              # teto por resposta (~16 s de fala); 0 = sem limite
# NURIA_IMAGEM_LADO=512             # px do maior lado da foto enviada (768 = mais detalhe, mais tokens)

# --- Modo legado (--ia legado: transcrição, visão e voz separadas) ---
# NURIA_MODELO_VISAO=gpt-4.1-mini
# NURIA_MODELO_STT=gpt-4o-mini-transcribe
# NURIA_MODELO_TTS=gpt-4o-mini-tts
# NURIA_VOZ=coral
